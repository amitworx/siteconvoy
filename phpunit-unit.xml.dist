<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="tests/bootstrap-unit.php"
    backupGlobals="false"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    beStrictAboutOutputDuringTests="true"
    convertErrorsToExceptions="true"
    convertWarningsToExceptions="true"
    convertNoticesToExceptions="true"
>
    <php>
        <const name="ABSPATH" value="./" />
        <const name="SITECONVOY_LOAD_FIXTURE_VALIDATOR_ONLY" value="true" />
    </php>
    <testsuites>
        <testsuite name="SiteConvoy Unit Test Suite">
            <file>./tests/PluginUnitTest.php</file>
            <file>./tests/DiscoveryContractsUnitTest.php</file>
            <file>./tests/MigrationPlanUnitTest.php</file>
            <file>./tests/PackageManifestUnitTest.php</file>
            <file>./tests/PackageArchiveWriterUnitTest.php</file>
            <file>./tests/PackageArchiveInspectorUnitTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
