<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="SiteConvoy Rules" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
    <description>Coding standards for SiteConvoy WordPress plugin.</description>

    <!-- Scan all PHP files in project -->
    <file>.</file>

    <!-- Exclude version control, dependencies, and temporary build paths -->
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tmp/*</exclude-pattern>
    <exclude-pattern>*/tests/wordpress/*</exclude-pattern>

    <!-- Exclude WordPress class/file naming conventions for PSR-4 includes and PHPUnit tests directories -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>*/includes/*</exclude-pattern>
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- Show progress and sniff codes -->
    <arg value="ps"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <!-- Set minimum supported WordPress version (matching tested baseline) -->
    <config name="minimum_supported_wp_version" value="6.7"/>

    <!-- Verify code against WordPress Coding Standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <!-- Verify custom prefixes for hooks, functions, classes, constants -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="siteconvoy"/>
                <element value="SiteConvoy"/>
                <element value="SITECONVOY"/>
            </property>
        </properties>
    </rule>
</ruleset>
